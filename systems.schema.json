{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "systems file",
  "description": "The Systems a mirrorboard's agents are announced in, referred to with system://.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "systems"
  ],
  "properties": {
    "systems": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "The System's name as people read it."
          },
          "url": {
            "type": "string",
            "description": "The System's address.",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
