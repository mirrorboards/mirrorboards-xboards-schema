{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One organization's mirrorboard: its owner, its config files, its units and the blueprints of units made later.",
  "properties": {
    "blueprints": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "blueprint": {
            "description": "The blueprint units are made from later.",
            "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
            "type": "string"
          },
          "creators": {
            "description": "Who of this organization may make a unit from the blueprint. Empty: nobody.",
            "items": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "key"
                    ]
                  },
                  "then": {
                    "properties": {
                      "agent": {
                        "pattern": "^agent\\+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?://[a-z][a-z0-9.-]{0,62}(?:/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)?$"
                      }
                    },
                    "required": [
                      "agent"
                    ]
                  }
                }
              ],
              "oneOf": [
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "agent"
                        ]
                      },
                      {
                        "required": [
                          "organization"
                        ]
                      },
                      {
                        "required": [
                          "definition"
                        ]
                      },
                      {
                        "required": [
                          "key"
                        ]
                      }
                    ]
                  },
                  "required": [
                    "account"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "account"
                        ]
                      },
                      {
                        "required": [
                          "organization"
                        ]
                      },
                      {
                        "required": [
                          "definition"
                        ]
                      }
                    ]
                  },
                  "required": [
                    "agent"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "account"
                        ]
                      },
                      {
                        "required": [
                          "agent"
                        ]
                      },
                      {
                        "required": [
                          "key"
                        ]
                      }
                    ]
                  },
                  "required": [
                    "organization"
                  ]
                }
              ],
              "properties": {
                "account": {
                  "description": "An account of the accounts file: account://<key>.",
                  "pattern": "^account://[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                  "type": "string"
                },
                "agent": {
                  "description": "An agent of this organization: agent://<unit>/<agent>.",
                  "pattern": "^agent://[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9]{1,20})?/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                  "type": "string"
                },
                "definition": {
                  "description": "A position of a definition: definition+<id>://spec/positions/... or .../spec/system.",
                  "pattern": "^definition\\+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?://spec/(?:positions(?:/[a-z0-9_]+)+|system)$",
                  "type": "string"
                },
                "key": {
                  "description": "The public key of one agent of another organization.",
                  "pattern": "^[A-Z]{2,8}[1-9A-HJ-NP-Za-km-z]{40,60}$",
                  "type": "string"
                },
                "organization": {
                  "description": "Every agent of this organization: the mirrorboard's own owner.",
                  "pattern": "^account://[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "A value for every parameter of the blueprint but `unit`, which the platform gives.",
            "not": {
              "required": [
                "unit"
              ]
            },
            "propertyNames": {
              "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "type": "object"
          }
        },
        "required": [
          "blueprint",
          "creators"
        ],
        "type": "object"
      },
      "description": "The blueprints of units made later, and who may make them.",
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "type": "object"
    },
    "mirrorboard": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "description": "The accounts file.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        },
        "chains": {
          "description": "The chains file.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        },
        "definitions": {
          "description": "The definitions file.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        },
        "history": {
          "description": "The history file: renames and retirements.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        },
        "label": {
          "description": "The organization's name as people read it.",
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "description": "An account of the accounts file: account://<key>.",
          "pattern": "^account://[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        "platforms": {
          "description": "The platforms file.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        },
        "standard": {
          "const": 1,
          "description": "The version of the standard the files follow."
        },
        "systems": {
          "description": "The systems file.",
          "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "label",
        "owner",
        "chains",
        "accounts",
        "definitions",
        "platforms",
        "systems"
      ],
      "type": "object"
    },
    "units": {
      "additionalProperties": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "description": "The unit's file.",
                "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
                "type": "string"
              }
            },
            "required": [
              "unit"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "blueprint": {
                "description": "The blueprint the unit is made from.",
                "pattern": "^\\./(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.toml$",
                "type": "string"
              },
              "parameters": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "A value for every parameter of the blueprint. `unit` equals this unit's key.",
                "propertyNames": {
                  "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                },
                "required": [
                  "unit"
                ],
                "type": "object"
              }
            },
            "required": [
              "blueprint",
              "parameters"
            ],
            "type": "object"
          }
        ]
      },
      "description": "The units that exist from the deploy on.",
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "type": "object"
    }
  },
  "required": [
    "mirrorboard"
  ],
  "title": "mirrorboard",
  "type": "object"
}
