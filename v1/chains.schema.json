{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The chains the accounts live on.",
  "properties": {
    "chains": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The chain's id: what the chain is.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "label": {
            "description": "The chain's name as people read it.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label",
          "id"
        ],
        "type": "object"
      },
      "description": "The key is used in chain://<key>.",
      "propertyNames": {
        "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "type": "object"
    }
  },
  "required": [
    "chains"
  ],
  "title": "chains",
  "type": "object"
}
