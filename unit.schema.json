{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unit file",
  "description": "One unit of a mirrorboard, e.g. a department or a notary's own part: its agents and its rooms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label"
  ],
  "properties": {
    "agents": {
      "$ref": "#/$defs/agents"
    },
    "rooms": {
      "type": "object",
      "description": "Rooms on the chain: registers (with a definition) and plain rooms such as agents' meta storage.",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner"
        ],
        "properties": {
          "definition": {
            "$ref": "#/$defs/register_definition",
            "description": "A register's definition. Without it the room is a plain room, e.g. an agent's meta storage."
          },
          "owner": {
            "$ref": "#/$defs/owner"
          },
          "permissions": {
            "type": "array",
            "description": "Who is a member of this room, and with which Actanet permissions (DATA_ROOM_PERM_*). An entry with only address reads only.",
            "items": {
              "$ref": "#/$defs/permission"
            }
          }
        }
      }
    },
    "label": {
      "type": "string",
      "description": "The unit's name as people read it."
    },
    "blueprints": {
      "type": "object",
      "description": "Blueprints of rooms made for agents created later.",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameters",
          "owner"
        ],
        "properties": {
          "parameters": {
            "type": "array",
            "description": "The parameters the blueprint uses, filled at each agent's birth.",
            "items": {
              "type": "string",
              "enum": [
                "agent"
              ]
            },
            "uniqueItems": true
          },
          "owner": {
            "$ref": "#/$defs/owner"
          },
          "permissions": {
            "type": "array",
            "description": "Who is a member of this room, and with which Actanet permissions (DATA_ROOM_PERM_*). An entry with only address reads only.",
            "items": {
              "$ref": "#/$defs/blueprint_permission"
            }
          }
        },
        "description": "A room made later, once for each agent that names it as meta. {{ agent }} is the address of that agent."
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "description": "The account that owns it: account://<key of the accounts file>. Always written out; nothing is owned by default.",
      "pattern": "^account://[a-z][a-z0-9.-]*$"
    },
    "position_definition": {
      "type": "string",
      "description": "The position in a definition, e.g. definition+kancelaria://spec/positions/ksiegowosc/glowny_ksiegowy.",
      "pattern": "^definition\\+[a-z][a-z0-9-]*://spec/(positions/.+|system)$"
    },
    "register_definition": {
      "type": "string",
      "description": "The register in a definition, e.g. definition+kancelaria://spec/registers/depozyty.",
      "pattern": "^definition\\+[a-z][a-z0-9-]*://spec/registers/.+$"
    },
    "agents": {
      "type": "object",
      "description": "Agents. One nested under another is created by it later; one at the top is born at the deploy.",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "owner"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/position_definition"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "meta": {
          "type": "string",
          "description": "Where the agent keeps its memory: room://<unit>/<room> for a standing agent, blueprint://<unit>/<blueprint> for one created later, whose room is made from the blueprint at its birth.",
          "pattern": "^(room|blueprint)://[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
        },
        "contacts": {
          "type": "array",
          "description": "Who may wake this agent and give it work: agents or accounts of this organization.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address"
            ],
            "properties": {
              "address": {
                "type": "string",
                "description": "agent://<unit>/<agent>[/<agent created later>] or account://<key>.",
                "pattern": "^(agent://[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+|account://[a-z][a-z0-9.-]*)$"
              }
            }
          }
        },
        "systems": {
          "type": "array",
          "description": "The Systems this agent is announced in, so agents outside the organization can find and wake it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "notice",
              "visibility",
              "wake"
            ],
            "properties": {
              "system": {
                "type": "string",
                "description": "system://<key of the systems file>.",
                "pattern": "^system://[a-z][a-z0-9-]*$"
              },
              "notice": {
                "type": "string",
                "description": "What the agent does, as others read it in the System."
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "participants"
                ],
                "description": "public: everyone sees the notice; participants: only the System's participants."
              },
              "wake": {
                "type": "string",
                "enum": [
                  "everyone",
                  "nobody",
                  "participants"
                ],
                "description": "Who in the System may wake the agent."
              }
            }
          }
        },
        "agents": {
          "$ref": "#/$defs/agents"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "description": "agent://<unit>/<agent>[/<agent created later>] or account://<key>.",
          "pattern": "^(agent://[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+|account://[a-z][a-z0-9.-]*)$"
        },
        "create_content": {
          "type": "boolean",
          "description": "Add new entries."
        },
        "manage_content": {
          "type": "boolean",
          "description": "Change and delete entries, also others'."
        },
        "grant_content": {
          "type": "boolean",
          "description": "Give others access to chosen entries."
        },
        "add_members": {
          "type": "boolean",
          "description": "Add members."
        },
        "remove_members": {
          "type": "boolean",
          "description": "Remove members."
        },
        "manage_permissions": {
          "type": "boolean",
          "description": "Change members' permissions, within its own."
        },
        "rotate_keys": {
          "type": "boolean",
          "description": "Replace the room's key, e.g. after removing a member."
        },
        "update_room": {
          "type": "boolean",
          "description": "Change the room's own settings."
        }
      }
    },
    "blueprint_permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "description": "agent://<unit>/<agent>, account://<name> or {{ agent }}.",
          "pattern": "^(agent://[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+|account://[a-z][a-z0-9.-]*|\\{\\{ agent \\}\\})$"
        },
        "create_content": {
          "type": "boolean",
          "description": "Add new entries."
        },
        "manage_content": {
          "type": "boolean",
          "description": "Change and delete entries, also others'."
        },
        "grant_content": {
          "type": "boolean",
          "description": "Give others access to chosen entries."
        },
        "add_members": {
          "type": "boolean",
          "description": "Add members."
        },
        "remove_members": {
          "type": "boolean",
          "description": "Remove members."
        },
        "manage_permissions": {
          "type": "boolean",
          "description": "Change members' permissions, within its own."
        },
        "rotate_keys": {
          "type": "boolean",
          "description": "Replace the room's key, e.g. after removing a member."
        },
        "update_room": {
          "type": "boolean",
          "description": "Change the room's own settings."
        }
      }
    }
  }
}
