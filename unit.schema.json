{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unit file",
  "description": "One unit of a mirrorboard, e.g. a department or a notary's own part: its agents and its rooms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label"
  ],
  "properties": {
    "agents": {
      "$ref": "#/$defs/agents"
    },
    "rooms": {
      "type": "object",
      "description": "Rooms on the chain: registers (with a definition) and plain rooms such as agents' meta storage.",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner"
        ],
        "properties": {
          "definition": {
            "$ref": "#/$defs/register_definition",
            "description": "A register's definition. Without it the room is a plain room, e.g. an agent's meta storage."
          },
          "owner": {
            "$ref": "#/$defs/owner"
          },
          "permissions": {
            "type": "array",
            "description": "Who is a member of this room, and with which Actanet permissions (DATA_ROOM_PERM_*). An entry with only address reads only.",
            "items": {
              "$ref": "#/$defs/permission"
            }
          }
        }
      }
    },
    "label": {
      "type": "string",
      "description": "The unit's name as people read it."
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "description": "The account that owns it: account://<key of the accounts file>. Always written out; nothing is owned by default.",
      "pattern": "^account://[a-z][a-z0-9.-]*$"
    },
    "position_definition": {
      "type": "string",
      "description": "The position in a definition, e.g. definition+kancelaria://spec/positions/ksiegowosc/glowny_ksiegowy.",
      "pattern": "^definition\\+[a-z][a-z0-9-]*://spec/(positions/.+|system)$"
    },
    "register_definition": {
      "type": "string",
      "description": "The register in a definition, e.g. definition+kancelaria://spec/registers/depozyty.",
      "pattern": "^definition\\+[a-z][a-z0-9-]*://spec/registers/.+$"
    },
    "agents": {
      "type": "object",
      "description": "Agents. One nested under another is created by it later; one at the top is born at the deploy.",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "owner"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/position_definition"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "meta": {
          "type": "string",
          "description": "The room this agent keeps its memory and metadata in: room://<unit>/<room>.",
          "pattern": "^room://[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
        },
        "contacts": {
          "type": "array",
          "description": "Who may wake this agent and give it work: an agent or account of this organization, or the agents of one position in a partner organization.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "description": "agent://<unit>/<agent> or account://<key>.",
                    "pattern": "^(agent://[a-z][a-z0-9-]*/[a-z][a-z0-9-]*|account://[a-z][a-z0-9.-]*)$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "organization",
                  "position"
                ],
                "properties": {
                  "organization": {
                    "type": "string",
                    "description": "A partner organization's account: account://<key of the accounts file>.",
                    "pattern": "^account://[a-z][a-z0-9.-]*$"
                  },
                  "position": {
                    "type": "string",
                    "description": "The partner's position whose agents may wake this one: definition+<id>://spec/positions/...",
                    "pattern": "^definition\\+[a-z][a-z0-9-]*://spec/positions/.+$"
                  }
                }
              }
            ]
          }
        },
        "systems": {
          "type": "array",
          "description": "The Systems this agent is announced in, so agents outside the organization can find and wake it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "notice",
              "visibility",
              "wake"
            ],
            "properties": {
              "system": {
                "type": "string",
                "description": "system://<key of the systems file>.",
                "pattern": "^system://[a-z][a-z0-9-]*$"
              },
              "notice": {
                "type": "string",
                "description": "What the agent does, as others read it in the System."
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "participants"
                ],
                "description": "public: everyone sees the notice; participants: only the System's participants."
              },
              "wake": {
                "type": "string",
                "enum": [
                  "everyone",
                  "nobody",
                  "participants"
                ],
                "description": "Who in the System may wake the agent."
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "description": "For an agent created later (nested): members of the meta room each such agent gets. A standing agent names its meta room with meta instead.",
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "agents": {
          "$ref": "#/$defs/agents"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "description": "agent://<unit>/<agent> or account://<name>.",
          "pattern": "^(agent://[a-z][a-z0-9-]*/[a-z][a-z0-9-]*|account://[a-z][a-z0-9.-]*)$"
        },
        "create_content": {
          "type": "boolean",
          "description": "Add new entries."
        },
        "manage_content": {
          "type": "boolean",
          "description": "Change and delete entries, also others'."
        },
        "grant_content": {
          "type": "boolean",
          "description": "Give others access to chosen entries."
        },
        "add_members": {
          "type": "boolean",
          "description": "Add members."
        },
        "remove_members": {
          "type": "boolean",
          "description": "Remove members."
        },
        "manage_permissions": {
          "type": "boolean",
          "description": "Change members' permissions, within its own."
        },
        "rotate_keys": {
          "type": "boolean",
          "description": "Replace the room's key, e.g. after removing a member."
        },
        "update_room": {
          "type": "boolean",
          "description": "Change the room's own settings."
        }
      }
    }
  }
}
